# Core Config
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb://mongodb:27017/counselweb

# Security Secrets (Must generate unique values in production)
JWT_SECRET=generate_a_secure_random_string_here
REFRESH_SECRET=generate_another_secure_random_string_here

# Client URL (For CORS validation)
CLIENT_URL=https://your-frontend-domain.com
